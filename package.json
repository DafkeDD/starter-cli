{
  "name": "starter-cli",
  "version": "0.1.0",
  "description": "Interactieve starter-CLI die een project scaffold op basis van vragen.",
  "type": "module",
  "bin": {
    "starter-cli": "dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "cli",
    "starter",
    "scaffold",
    "nextjs"
  ],
  "author": "DafkeDD",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
